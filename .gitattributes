# 文本统一使用 LF；Windows 批处理保留 CRLF。
* text=auto eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.mcmeta text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# 游戏资源和 Gradle wrapper 不做文本转换。
*.png binary
*.nbt binary
*.jar binary
